# Les Trios (ex-« Blueprints ») sont un onglet de la page Builds. Les anciennes
# adresses, déjà indexées et partagées, y renvoient définitivement.
/blueprints    /hub/?onglet=trios  301
/blueprints/   /hub/?onglet=trios  301
/blueprints/*  /hub/?onglet=trios  301
/trios         /hub/?onglet=trios  301
/trios/        /hub/?onglet=trios  301
/trios/*       /hub/?onglet=trios  301

# « Progression » fait désormais partie de la page « Mon build ».
/progression    /mon-build/?onglet=progression  301
/progression/   /mon-build/?onglet=progression  301
/progression/*  /mon-build/?onglet=progression  301

# Profils publics : une page par joueur, un seul fichier. Le slug est lu dans
# l'adresse par profil.js. Statut 200 = on sert la page sans changer l'URL.
/u/*     /u/index.html     200
/en/u/*  /en/u/index.html  200
