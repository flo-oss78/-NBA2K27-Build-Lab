/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Les cinq pages du site doivent être revalidées à chaque visite, sans quoi un
# déploiement peut rester invisible derrière le cache du navigateur.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/trios/*
  Cache-Control: public, max-age=0, must-revalidate

/hub/*
  Cache-Control: public, max-age=0, must-revalidate

/reference/*
  Cache-Control: public, max-age=0, must-revalidate

/progression/*
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Le service worker assure déjà la vitesse et le hors-ligne : garder en plus
# 10 minutes de cache navigateur ne faisait que retarder les déploiements,
# jusqu'à figer une version périmée dans la coquille du service worker.
/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/api/*
  Cache-Control: no-store
